# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# production variable secrets
.env

# for storing temporary files to local
/tmp

# .NET build output and IDE files
bin/
obj/
.vs/
*.user

# Demo builds from scripts/publish.ps1 and scripts/publish.sh
publish/

# SQLite databases (accounts and match history live on the host only)
*.db
*.db-journal
*.db-wal
*.db-shm

# Ignore auto-generated .NET test results
**/TestResults/
